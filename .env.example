# MicroQuant Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false

# Streamlit UI Settings
STREAMLIT_PORT=8501

# Data Paths (relative to project root or absolute)
RAW_DATA_PATH=data/raw/trades_orderbook_STUDENT_dirty.csv
CLEAN_DATA_PATH=data/processed/trades_clean.csv
FEATURES_DATA_PATH=data/processed/features_tick.csv
CANDLES_1MIN_PATH=data/processed/candles_1min.csv
CANDLES_5S_PATH=data/processed/candles_5s.csv
MODEL_DIR=data/models

# Machine Learning & Alpha Settings
TICK_HORIZON=10
TRAIN_TEST_SPLIT_RATIO=0.75
RANDOM_STATE=42
PYTORCH_EPOCHS=40
BATCH_SIZE=32
LEARNING_RATE=0.001

# Backtesting Simulation Parameters
MAKER_FEE_BPS=1.0
TAKER_FEE_BPS=4.0
SLIPPAGE_BPS=1.5
INITIAL_CAPITAL=100000.0
